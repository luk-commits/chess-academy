{
    "name": "chess-academy/backend",
    "description": "ChessAcademy backend API built on Phalcon",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-phalcon": "^5.0",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "ChessAcademy\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
